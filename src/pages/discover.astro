---
import Base from '../layouts/Base.astro';
import GuideCard from '../components/GuideCard.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { destinations } from '../data/destinations';
import { getGeneratedImage } from '../data/generatedImages';
import { communityVideos } from '../data/communityVideos';
import { yangpuLocalUseCollection } from '../data/curatedCollections';
import { auditDestination } from '../utils/destinationQuality.js';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);

const intents = [
  {
    id: 'places',
    label: 'Places',
    icon: 'map',
    body: 'Find entry regions and starter pins before you build the route.',
    image: getGeneratedImage('home:places')?.src ?? '/images/curated/home-places.jpg',
    alt: getGeneratedImage('home:places')?.alt ?? 'Great Wall landscape in northern China',
    guideIds: ['7-day-china-itinerary', 'neighborhoods-beyond-landmarks', 'festivals-and-local-experiences'],
  },
  {
    id: 'eating',
    label: 'Eating',
    icon: 'bowl',
    body: 'Save food streets, tea houses, and local meals worth detouring for.',
    image: getGeneratedImage('home:eating')?.src ?? '/images/curated/home-eating.jpg',
    alt: getGeneratedImage('home:eating')?.alt ?? 'Street food stall in China',
    guideIds: ['street-food-night-markets', 'food-ordering-dietary', 'tea-houses-and-rituals'],
  },
  {
    id: 'traveling',
    label: 'Traveling',
    icon: 'train',
    body: 'Keep trains, metros, and hard-to-find addresses tied to the same plan.',
    image: getGeneratedImage('home:traveling')?.src ?? '/images/curated/home-traveling.jpg',
    alt: getGeneratedImage('home:traveling')?.alt ?? 'High-speed train at a China rail platform',
    guideIds: ['china-attraction-tickets-reservations', 'china-high-speed-trains', 'didi-metro-getting-around', 'internet-esim-vpn-blocked-apps', '7-day-china-itinerary'],
  },
  {
    id: 'hospitality',
    label: 'Hospitality',
    icon: 'passport',
    body: 'Choose neighborhoods and hotels that actually work for foreign passports.',
    image: getGeneratedImage('home:hospitality')?.src ?? '/images/curated/home-hospitality.jpg',
    alt: getGeneratedImage('home:hospitality')?.alt ?? 'Hotel lobby in China',
    guideIds: ['hotels-foreigners-china', 'neighborhoods-beyond-landmarks', 'translation-language-survival', 'china-pre-departure-checklist'],
  },
] as const;

const intentForGuide = (guideId: string) =>
  intents.filter((intent) => intent.guideIds.includes(guideId as never)).map((intent) => intent.id);
const intentForDestination = (guideIds: string[]) => {
  const matched = intents
    .filter((intent) => intent.guideIds.some((guideId) => guideIds.includes(guideId)))
    .map((intent) => intent.id);
  return [...new Set(['places', ...matched])];
};
const description =
  'Explore local China guides built from Chinese-language research, grounded traveler evidence, and bilingual place identities.';
const videosForDestination = (slug: string) => communityVideos.filter((video) => video.destinationSlug === slug);
const localGuideHref = `/curated/${yangpuLocalUseCollection.owner.slug}/${yangpuLocalUseCollection.pathSlug}/shanghai/`;
const localGuideEvidenceHref = `${localGuideHref}#source-notes-heading`;
const localGuideContributionHref = '/map-import/?contributionCity=Shanghai&contributionLanguage=Chinese&contributionPlatform=xiaohongshu&contributionKind=place#contribute';
const localGuideCandidates = yangpuLocalUseCollection.places;
const localGuideSourceNotes = yangpuLocalUseCollection.sourceNotes ?? [];
const localGuideSafePins = localGuideCandidates.filter((place) => place.resolutionState === 'resolved').length;
const localGuideDirectResident = localGuideCandidates.filter((place) => place.evidenceGrade === 'resident-direct').length;
const localGuideReviewLeads = localGuideCandidates.length - localGuideSafePins;
const localGuideSearchText = [
  yangpuLocalUseCollection.title,
  yangpuLocalUseCollection.description,
  yangpuLocalUseCollection.methodNote ?? '',
  ...localGuideSourceNotes.flatMap((note) => [note.platform, note.title, note.originalLanguage, note.localSignal]),
  ...localGuideSourceNotes.flatMap((note) => [note.originalCue ?? '', note.cueMeaning ?? '']),
  ...localGuideCandidates.flatMap((place) => [place.name, place.localName ?? '', place.address, place.localUse ?? '', place.evidence ?? '', place.travelerContext ?? '', place.evidenceLabel ?? '', place.originalCue ?? '', place.cueMeaning ?? '']),
].join(' ').toLowerCase();
const videoSearchText = (slug: string) => videosForDestination(slug)
  .flatMap((video) => [
    video.title,
    video.creator,
    video.summary,
    video.guideTitle ?? '',
    video.guideBody ?? '',
    ...video.places.flatMap((place) => [place.name, place.localName, place.address, place.evidence]),
  ])
  .join(' ');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Local China travel guides',
    url: 'https://chinatravelmadeeasy.com/discover/',
    description,
    isPartOf: { '@type': 'WebSite', url: 'https://chinatravelmadeeasy.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'China destinations and locally researched travel guides',
    numberOfItems: destinations.length + guides.length,
    itemListElement: [
      ...destinations.map((destination, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: destination.name,
        url: `https://chinatravelmadeeasy.com/regions/${destination.slug}/`,
      })),
      ...guides.map((guide, index) => ({
        '@type': 'ListItem',
        position: destinations.length + index + 1,
        name: guide.data.title,
        url: `https://chinatravelmadeeasy.com/guides/${guide.id}/`,
      })),
    ],
  },
];
---

<Base title="Local China travel guides" description={description} jsonLd={jsonLd}>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
    <div class="grid gap-6 lg:grid-cols-[0.86fr_1.14fr] lg:items-end">
      <div>
        <p class="ds-eyebrow">Local China guides</p>
        <h1 class="mt-2 text-4xl leading-tight sm:text-5xl">Plan the China trip locals would recognize.</h1>
      </div>
      <p class="text-lg leading-relaxed text-soft">
        Start with the experience you want. Explore places surfaced through Chinese-language research, then keep the local evidence, English context, and bilingual map identity together.
      </p>
    </div>

    <div class="ds-context-grid mt-8" role="group" aria-label="Filter discovery by travel need">
      {intents.map((intent) => (
        <button type="button" class="ds-context-card group text-left" data-discover-filter={intent.id} aria-pressed="false">
          <div class="ds-context-thumb">
            <img src={intent.image} alt={intent.alt} loading="lazy" />
          </div>
          <div class="p-4">
            <span class="ds-icon-tile">
              <Icon name={intent.icon} class="h-5 w-5" />
            </span>
            <h2 class="mt-4 text-2xl leading-tight group-hover:text-accent">{intent.label}</h2>
            <p class="mt-2 text-sm leading-relaxed text-soft">{intent.body}</p>
          </div>
        </button>
      ))}
    </div>

    <div class="mt-6 flex justify-end">
      <label class="w-full sm:w-96">
        <span class="sr-only">Search destinations, places, and guides</span>
        <input id="discoverSearch" class="ds-input w-full" type="search" placeholder="Search a city, place, or problem" />
      </label>
    </div>

    <aside class="mt-8 grid gap-5 rounded-3xl border border-line bg-white p-5 sm:p-7 lg:grid-cols-[1fr_auto] lg:items-center" aria-labelledby="local-lens-study-heading">
      <div>
        <p class="ds-eyebrow">How the guides are made</p>
        <h2 id="local-lens-study-heading" class="mt-2 text-2xl leading-tight sm:text-3xl">Search China’s local internet before writing the guide</h2>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-soft">Our agent searches in Chinese, keeps the original evidence, explains why locals use a place, and checks its map identity before presenting it to an English-speaking traveler.</p>
      </div>
      <div class="flex flex-wrap gap-2 lg:justify-end">
        <a href="/research/local-lens/" class="ds-button ds-button-dark whitespace-nowrap">See the research method</a>
      </div>
    </aside>

    <section class="mt-10" aria-labelledby="local-source-guide-heading">
      <p class="ds-eyebrow">Locally researched field guide</p>
      <article
        class="mt-4 grid gap-5 rounded-3xl border border-line bg-[linear-gradient(135deg,#fff_0%,#f6efe3_52%,#eef3ee_100%)] p-5 sm:p-7 lg:grid-cols-[0.82fr_1.18fr] lg:items-stretch"
        data-discover-item
        data-title={yangpuLocalUseCollection.title.toLowerCase()}
        data-intents="places"
        data-search={localGuideSearchText}
      >
        <div class="flex h-full flex-col">
          <p class="ds-tag">Chinese-source guide · Shanghai</p>
          <h2 id="local-source-guide-heading" class="mt-3 text-3xl leading-tight sm:text-4xl">{yangpuLocalUseCollection.title}</h2>
          <p class="mt-4 leading-relaxed text-soft">{yangpuLocalUseCollection.description}</p>
          <div class="mt-5 grid grid-cols-3 gap-2">
            <div class="rounded-xl border border-line bg-white/80 p-3">
              <p class="ds-tag">Source notes</p>
              <p class="mt-2 text-2xl leading-none">{localGuideSourceNotes.length}</p>
            </div>
            <div class="rounded-xl border border-line bg-white/80 p-3">
              <p class="ds-tag">Candidates</p>
              <p class="mt-2 text-2xl leading-none">{localGuideCandidates.length}</p>
            </div>
            <div class="rounded-xl border border-line bg-white/80 p-3">
              <p class="ds-tag">Safe pins</p>
              <p class="mt-2 text-2xl leading-none">{localGuideSafePins}</p>
            </div>
          </div>
          <div class="mt-auto flex flex-wrap gap-2 pt-6">
            <a href={localGuideHref} class="ds-button ds-button-dark">Open the local guide</a>
            <a href={localGuideContributionHref} class="ds-button ds-button-secondary">Add Chinese source</a>
            <a href="/research/local-lens/" class="ds-button ds-button-secondary">See the research method</a>
          </div>
        </div>
        <div class="grid gap-3">
          <div class="rounded-2xl border border-line bg-white/80 p-4">
            <p class="ds-eyebrow">What makes it different</p>
            <p class="mt-2 text-sm leading-relaxed text-soft">Local evidence creates candidates, not automatic pins. This slice has {localGuideDirectResident} direct resident signal and only {localGuideSafePins} provider-resolved place.</p>
          </div>
          <div class="rounded-2xl border border-line bg-white/80 p-4">
            <p class="ds-eyebrow">Try the local-to-map loop</p>
            <h3 class="mt-2 text-xl leading-tight">Start with what Shanghai locals use, then save only the pin that survives review.</h3>
            <ol class="mt-3 grid gap-2 text-sm leading-relaxed text-soft">
              <li><span class="font-semibold text-ink">1.</span> Read the original Chinese cue and why it matters.</li>
              <li><span class="font-semibold text-ink">2.</span> Save the one provider-resolved place to Profile.</li>
              <li><span class="font-semibold text-ink">3.</span> Keep the other {localGuideReviewLeads} local leads attached to the evidence ledger.</li>
            </ol>
            <div class="mt-4 flex flex-wrap gap-2">
              <a href={localGuideEvidenceHref} class="ds-button ds-button-dark">Open evidence ledger</a>
              <a href={localGuideHref} class="ds-button ds-button-secondary">Save reviewed pin</a>
            </div>
            <p class="mt-3 border-t border-line pt-3 text-xs leading-relaxed text-soft">Have a Xiaohongshu, Dianping, or short-video lead? Add it as a UGC review packet first; it becomes a guide candidate only after local wording and provider identity are checked.</p>
          </div>
          <div class="rounded-2xl border border-line bg-white/80 p-4">
            <p class="ds-eyebrow">From Chinese source to map-ready pin</p>
            <div class="mt-3 grid gap-2 text-sm leading-relaxed">
              <p><span class="font-semibold text-ink">Chinese local source</span> → keep the original wording, platform, and local-use claim.</p>
              <p><span class="font-semibold text-ink">Evidence-graded candidate</span> → separate direct resident testimony, corroborated signals, and proxy claims.</p>
              <p><span class="font-semibold text-ink">{localGuideSafePins} safe pin</span> → save only when the branch or venue identity is provider-resolved.</p>
              <p><span class="font-semibold text-ink">{localGuideReviewLeads} review leads stay visible</span> → useful ideas remain attached to evidence without becoming false pins.</p>
            </div>
            <p class="mt-3 border-t border-line pt-3 text-xs leading-relaxed text-soft">Adding a source opens a scoped review packet for local wording, translation, duplicate checks, and provider resolution.</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-3">
            {localGuideSourceNotes.map((note) => {
              const linked = note.candidateIds
                .map((id) => localGuideCandidates.find((place) => place.id === id))
                .filter(Boolean);
              const mapReady = linked.filter((place) => place?.resolutionState === 'resolved').length;
              return (
                <a href={localGuideHref} class="rounded-2xl border border-line bg-white/80 p-4 hover:border-accent">
                  <div class="flex items-start justify-between gap-2">
                    <p class="ds-tag">{note.platform}</p>
                    <p class="text-xs font-semibold text-accent">{note.originalLanguage}</p>
                  </div>
                  <h3 class="mt-3 text-lg leading-tight">{note.title}</h3>
                  {note.originalCue && (
                    <p class="mt-2 rounded-md border border-line bg-paper px-3 py-2 text-xs leading-relaxed text-ink">
                      <span class="font-semibold">Original cue:</span> {note.originalCue}
                      {note.cueMeaning && <span class="block text-soft">{note.cueMeaning}</span>}
                    </p>
                  )}
                  <p class="mt-2 text-sm leading-relaxed text-soft">{note.localSignal}</p>
                  <p class="mt-3 border-t border-line pt-3 text-xs font-semibold text-soft">{linked.length} candidate{linked.length === 1 ? '' : 's'} · {mapReady} map-ready</p>
                </a>
              );
            })}
          </div>
        </div>
      </article>
    </section>

    <section class="mt-12" aria-labelledby="map-ready-heading">
      <p class="ds-eyebrow">Places to go</p>
      <h2 id="map-ready-heading" class="mt-2 text-3xl leading-tight">Choose where you want to go deeper</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-soft">
        Full destination guides combine local-language research, editorial judgment, grounded traveler media, and bilingual places. Starter briefs remain clearly marked until they meet the same standard.
      </p>
      <div id="discoverDestinations" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {destinations.map((destination) => {
          const videos = videosForDestination(destination.slug);
          const quality = auditDestination(destination, videos);
          const leadVideo = videos[0];
          const resolvedCount = new Set(videos.flatMap((video) => video.places.filter((place) => place.resolution === 'resolved').map((place) => place.id))).size;
          return (
            <article
              class="ds-card group flex h-full flex-col overflow-hidden"
              data-discover-item
              data-title={destination.name.toLowerCase()}
              data-intents={intentForDestination(destination.guideIds).join(' ')}
              data-search={`${destination.name} ${destination.summary} ${destination.places.map((place) => `${place.name} ${place.area} ${place.mapQuery}`).join(' ')} ${videoSearchText(destination.slug)}`.toLowerCase()}
            >
              <a href={`/regions/${destination.slug}/`} class="relative block aspect-[16/9] overflow-hidden bg-surface-strong">
                <img src={leadVideo?.poster ?? destination.image.src} alt={leadVideo?.title ?? destination.image.alt} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" referrerpolicy={leadVideo ? 'no-referrer' : undefined} />
                {leadVideo && <span class="absolute bottom-3 left-3 rounded-full bg-ink/85 px-3 py-1 text-xs font-semibold text-white">▶ {leadVideo.creator}</span>}
              </a>
              <div class="flex flex-1 flex-col p-5">
                <p class="ds-tag">{quality.tier === 'full' ? 'Destination digest' : 'Starter brief'} · {destination.type}</p>
                <h3 class="mt-2 text-2xl leading-tight">
                  <a href={`/regions/${destination.slug}/`} class="hover:text-accent">{destination.name}</a>
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-soft">{destination.summary}</p>
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {destination.places.slice(0, 3).map((place) => (
                    <span class="rounded-full border border-line bg-white px-2.5 py-1 text-xs text-soft">{place.name}</span>
                  ))}
                </div>
                {videos.length > 0 && (
                  <a href={`/regions/${destination.slug}/#field-notes`} class="mt-5 flex items-center gap-3 border-t border-line pt-4 text-accent hover:text-ink">
                    <span class="flex shrink-0 -space-x-2" aria-hidden="true">
                      {videos.slice(0, 3).map((video) => (
                        <img src={video.poster} alt="" class="h-10 w-8 rounded border-2 border-white object-cover" loading="lazy" referrerpolicy="no-referrer" />
                      ))}
                    </span>
                    <span class="min-w-0 text-xs font-semibold leading-relaxed">
                      {videos.length} traveler {videos.length === 1 ? 'story' : 'stories'} · {resolvedCount} identified {resolvedCount === 1 ? 'place' : 'places'}
                    </span>
                    <Icon name="arrow" class="ml-auto h-3.5 w-3.5 shrink-0" />
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="mt-14 border-t border-line pt-10" aria-labelledby="guide-heading">
      <p class="ds-eyebrow">Make the local find usable</p>
      <h2 id="guide-heading" class="mt-2 text-3xl leading-tight">Practical guides for navigating what you find</h2>
      <div id="discoverGuides" class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {guides.map((guide) => (
          <div
            data-discover-item
            data-title={guide.data.title.toLowerCase()}
            data-intents={intentForGuide(guide.id).join(' ')}
            data-search={`${guide.data.title} ${guide.data.description} ${guide.data.category} ${guide.data.mapPlaces.map((place) => `${place.name} ${place.localName ?? ''} ${place.city}`).join(' ')}`.toLowerCase()}
          >
            <GuideCard guide={guide} />
          </div>
        ))}
      </div>
    </section>

    <p id="discoverEmpty" class="ds-panel mt-8 hidden p-6 text-center text-soft">
      No grounded match yet. Try a city or problem, or paste the original tip into <a href="/map-import/" class="font-semibold text-accent hover:underline">Save Places</a> for review.
    </p>

    <section class="mt-14 border-t border-line pt-10" aria-labelledby="handoff-heading">
      <p class="ds-eyebrow">The China-specific method</p>
      <h2 id="handoff-heading" class="mt-2 text-3xl leading-tight">How local research becomes a usable guide</h2>
      <ol class="mt-6 grid gap-4 md:grid-cols-4">
        {[
          ['1', 'Search locally', 'Research the experience in Chinese and retrieve the original local evidence.'],
          ['2', 'Interpret', 'Explain why locals use the place and what transfers to a visitor’s trip.'],
          ['3', 'Resolve', 'Match the Chinese name, city, branch, and map-provider identity.'],
          ['4', 'Curate', 'Publish the English field guide and keep uncertain findings visibly under review.'],
        ].map(([step, title, body]) => (
          <li class="ds-card p-5">
            <span class="ds-tag">Step {step}</span>
            <h3 class="mt-3 text-xl">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-soft">{body}</p>
          </li>
        ))}
      </ol>
    </section>
  </section>

  <script define:vars={{ intents }}>
    const filterButtons = [...document.querySelectorAll('[data-discover-filter]')];
    const items = [...document.querySelectorAll('[data-discover-item]')];
    const search = document.querySelector('#discoverSearch');
    const empty = document.querySelector('#discoverEmpty');
    const validIntents = intents.map((intent) => intent.id);
    const requestedIntent = new URLSearchParams(window.location.search).get('intent');
    let activeIntent = validIntents.includes(requestedIntent) ? requestedIntent : 'places';

    const applyFilters = () => {
      const query = search.value.trim().toLowerCase();
      const hasExactTitle = Boolean(query && items.some((item) => (item.dataset.title || '') === query));
      let visible = 0;
      items.forEach((item) => {
        const intentMatch = (item.dataset.intents || '').split(' ').includes(activeIntent);
        const searchMatch = !query || (hasExactTitle
          ? (item.dataset.title || '') === query
          : (item.dataset.search || '').includes(query));
        const show = intentMatch && searchMatch;
        item.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });
      filterButtons.forEach((button) => {
        const selected = button.dataset.discoverFilter === activeIntent;
        button.setAttribute('aria-pressed', String(selected));
        button.classList.toggle('discover-intent-active', selected);
      });
      empty.classList.toggle('hidden', visible > 0);
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeIntent = button.dataset.discoverFilter;
        const url = new URL(window.location.href);
        url.searchParams.set('intent', activeIntent);
        window.history.replaceState({}, '', url);
        applyFilters();
      });
    });
    search.addEventListener('input', applyFilters);
    applyFilters();
  </script>

  <style>
    .discover-intent-active {
      border-color: var(--color-accent);
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-accent) 18%, transparent);
    }
  </style>
</Base>
